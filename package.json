{
  "name": "bytesend",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:editor": "turbo build --filter=@bytesend/email-editor",
    "build:web": "turbo build --filter=@bytesend/email-editor  --filter=web ",
    "build:marketing": "turbo build --filter=@bytesend/email-editor --filter=marketing",
    "build:smtp": "turbo build --filter=smtp-server",
    "build:web:local": "pnpm load-env -- turbo build --filter=@bytesend/email-editor  --filter=web ",
    "start:web:local": "pnpm load-env -- cd apps/web && pnpm start",
    "dev": "pnpm load-env -- turbo dev",
    "dev:local": "dotenv -e .env.local -- turbo dev --env-mode=loose",
    "dx:migrate": "dotenv -e .env.local -- pnpm --filter=web db:migrate-deploy",
    "test:web": "pnpm --filter=web test",
    "test:web:all": "pnpm test:infra:up && (pnpm --filter=web test:all; code=$?; pnpm test:infra:down; exit $code)",
    "test:web:all:raw": "pnpm --filter=web test:all",
    "test:web:unit": "pnpm --filter=web test:unit",
    "test:web:trpc": "pnpm --filter=web test:trpc",
    "test:web:api": "pnpm --filter=web test:api",
    "test:web:integration": "pnpm --filter=web test:integration",
    "test:web:integration:full": "pnpm test:infra:up && (pnpm --filter=web test:integration:full; code=$?; pnpm test:infra:down; exit $code)",
    "test:infra:up": "docker compose -f docker/testing/compose.yml up -d --wait",
    "test:infra:down": "docker compose -f docker/testing/compose.yml down -v",
    "dev:docs": "cd apps/docs && mintlify dev",
    "dev:marketing": "cd apps/marketing && turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm db db:generate",
    "db:push": "pnpm db db:push",
    "db:migrate-dev": "pnpm db db:migrate-dev",
    "db:migrate-deploy": "pnpm db db:migrate-deploy",
    "db:migrate-reset": "pnpm db db:migrate-reset",
    "db:studio": "pnpm db db:studio",
    "db": "pnpm load-env -- pnpm --filter=web",
    "load-env": "dotenv -e .env",
    "stripe:seed": "pnpm load-env -- pnpm --filter=web stripe:seed",
    "stripe:seed:dev": "pnpm load-env -- pnpm --filter=web stripe:seed:dev",
    "stripe:seed:staging": "pnpm load-env -- pnpm --filter=web stripe:seed:staging",
    "stripe:seed:prod": "pnpm load-env -- pnpm --filter=web stripe:seed:prod",
    "stripe:listen": "pnpm load-env -- stripe listen --forward-to localhost:3000/api/webhook/stripe",
    "d": "pnpm dx && pnpm dev",
    "dx": "pnpm i && pnpm dx:up && pnpm db:migrate-dev",
    "dx:up": "docker compose -f docker/dev/compose.yml up -d",
    "dx:down": "docker compose -f docker/dev/compose.yml down"
  },
  "devDependencies": {
    "@bytesend/eslint-config": "workspace:*",
    "@bytesend/typescript-config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "mintlify": "latest",
    "prettier": "^3.5.3",
    "stripe": "^17.7.0",
    "tsx": "^4.19.2"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "turbo": "^2.5.2"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers@5": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    },
    "overrides": {
      "shiki": "3.3.0",
      "@types/react": "19.1.2",
      "@types/react-dom": "19.1.2"
    }
  }
}